{
  "name": "@velqora/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "EXPO_NO_REDIRECT_PAGE=1 dotenv -e ../../.env -- expo start --dev-client",
    "dev:staging": "EXPO_NO_REDIRECT_PAGE=1 EXPO_PUBLIC_API_URL=https://velqora-api-staging.onrender.com EXPO_PUBLIC_SENTRY_ENVIRONMENT=staging dotenv -e ../../.env -- expo start --dev-client",
    "dev:lan": "EXPO_NO_REDIRECT_PAGE=1 dotenv -e ../../.env -- expo start --lan --dev-client",
    "start": "EXPO_NO_REDIRECT_PAGE=1 dotenv -e ../../.env -- expo start --dev-client",
    "android": "EXPO_NO_REDIRECT_PAGE=1 dotenv -e ../../.env -- expo start --android --dev-client",
    "ios": "EXPO_NO_REDIRECT_PAGE=1 dotenv -e ../../.env -- expo start --ios --dev-client",
    "web": "dotenv -e ../../.env -- expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@sentry/react-native": "~7.13.0",
    "country-state-city": "^3.2.1",
    "expo": "~57.0.11",
    "expo-apple-authentication": "^57.0.1",
    "expo-auth-session": "~57.0.6",
    "expo-blur": "~57.0.2",
    "expo-crypto": "^57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.11.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "private": true
}
